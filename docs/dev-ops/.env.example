# 复用当前 WSL Docker 已存在的数据库、Redis 和网络，不重新初始化数据。
MYSQL_HOST=mysql
MYSQL_DATABASE=group_buy_market
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-existing-mysql-password
REDIS_HOST=redis
DOCKER_NETWORK=dev-ops_my-network

APP_IMAGE=system/group-buy-market-hxy-app:1.0-SNAPSHOT
JAVA_BASE_IMAGE=eclipse-temurin:8-jre
MAVEN_BASE_IMAGE=maven:3.9-eclipse-temurin-8
NGINX_IMAGE=nginx:stable-alpine
APP_PORT=8091
FRONT_BIND=127.0.0.1
FRONT_PORT=80
